# ── GestureBridge Backend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── MongoDB ────────────────────────────────────────────────────────────────
# Local dev:  mongodb://localhost:27017/gesturebridge
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/gesturebridge
MONGO_URI=mongodb://localhost:27017/gesturebridge

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_strong_random_secret

# ── IBM Watsonx.ai (optional — AI features degrade gracefully without it) ──
IBM_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Flask ──────────────────────────────────────────────────────────────────
# Set to 0 in production. Render / gunicorn sets this automatically.
FLASK_DEBUG=0

# Port is set by the hosting platform (Render injects $PORT automatically).
# Leave blank locally — app.py defaults to 5000.
PORT=
