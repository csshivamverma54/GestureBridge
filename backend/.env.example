# ── GestureBridge Backend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the real .env to source control.

# ── MongoDB ────────────────────────────────────────────────────────────────
# Local dev:  mongodb://localhost:27017/gesturebridge
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/gesturebridge
MONGO_URI=mongodb://localhost:27017/gesturebridge

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_strong_random_secret

# ── IBM Watsonx.ai (optional — AI features degrade gracefully without it) ──
IBM_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Google OAuth ───────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for local dev : http://localhost:5000/auth/google/callback
# Authorized redirect URI for production: https://<your-render-url>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Where Flask redirects the browser after OAuth (your React app's origin)
FRONTEND_ORIGIN=http://localhost:3000

# ── Flask ──────────────────────────────────────────────────────────────────
# Set to 0 in production. Gunicorn ignores this anyway.
FLASK_DEBUG=0

# PORT is injected automatically by hosting platforms (Render, Railway, etc.)
# Leave blank for local dev — app.py defaults to 5000.
PORT=
