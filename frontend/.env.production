# Split-origin production deployment:
#   Frontend : https://gesturebridge1.onrender.com  (this React static site)
#   Backend  : https://gesturebridge.onrender.com   (Flask API)
#
# VITE_API_URL — prefixed onto every Axios request and video URL.
# Must be the full backend origin with NO trailing slash.
VITE_API_URL=https://gesturebridge.onrender.com

# VITE_BACKEND_URL — used by Auth.jsx to redirect the browser to /auth/google
# on the Flask server (can't use a relative path when on a different origin).
VITE_BACKEND_URL=https://gesturebridge.onrender.com
