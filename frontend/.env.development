# Development — Vite dev server on :3000, Flask on :5000.
# VITE_API_URL is empty: all API/video paths are proxied by Vite (see vite.config.js).
VITE_API_URL=

# VITE_BACKEND_URL must point directly at Flask for Google OAuth.
# window.location.href is a full-page browser navigation — Vite's proxy
# only intercepts same-page XHR/fetch requests, NOT browser navigations.
# So /auth/google MUST go straight to Flask :5000, not through Vite :3000.
VITE_BACKEND_URL=http://localhost:5000
